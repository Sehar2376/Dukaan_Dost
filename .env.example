# Copy this file to backend/.env and fill in real values. Never commit .env.

# --- Nebius Token Factory (required) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Copy the exact model IDs from the Token Factory playground ("View code").
NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Ultra is listed in the us-central1 region; used automatically if the main address doesn't serve it
NEBIUS_ULTRA_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# --- Firebase (leave empty to use the in-memory database while developing) ---
# Path to the service-account JSON file, e.g. firebase-key.json (inside backend/, never committed)
FIREBASE_CREDENTIALS=
# Seconds to reuse Firebase data before reading it again (saves the free daily read quota). Default 120.
FIRESTORE_CACHE_SECONDS=120

# --- Credit protection (no AI call once a limit is reached) ---
# messages per phone number per day / whole app per day / estimated AI spend per day (see GET /usage)
DAILY_MESSAGE_LIMIT=40
TOTAL_DAILY_LIMIT=500
DAILY_BUDGET_USD=1.50
# Prices per 1M tokens used for the estimate. Check the Token Factory pricing page.
PRICE_NANO_IN=0.06
PRICE_NANO_OUT=0.24
PRICE_SUPER_IN=0.30
PRICE_SUPER_OUT=0.90
PRICE_ULTRA_IN=1.00
PRICE_ULTRA_OUT=3.00
SHOP_TIMEZONE=Asia/Karachi

# --- Twilio WhatsApp sandbox (Day 14) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your Render URL, needed to check Twilio's signature: e.g. https://dukaan-dost-api.onrender.com
PUBLIC_BASE_URL=

# Owner's own WhatsApp number for the nightly report (format +923001234567). Optional.
OWNER_WHATSAPP=

# --- Tavily web search: market price check (optional, bonus prize) ---
# Free key at app.tavily.com (1,000 searches/month, no card). Empty = labelled sample results.
TAVILY_API_KEY=
TAVILY_DAILY_LIMIT=30

# Practice mode: 1 = fake AI, $0 (also automatic while NEBIUS_API_KEY is empty). 0 = real Nemotron.
MOCK_AI=0
